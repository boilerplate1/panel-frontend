;(function attachRightClickBlocker() {
  function blockContextMenu(opts = {}) {
    const { allowSelectors = [] } = opts

    const isAllowedTarget = (el) =>
      allowSelectors.length > 0 &&
      el instanceof Element &&
      allowSelectors.some((sel) => el.closest(sel))

    const onContextMenu = (e) => {
      if (!isAllowedTarget(e.target)) {
        e.preventDefault()
      }
    }

    // Shift+F10 тоже открывает контекстное меню
    const onKeyDown = (e) => {
      if (e.shiftKey && (e.key === 'F10' || e.keyCode === 121)) {
        // Разрешаем только в «белых» зонах
        if (!isAllowedTarget(document.activeElement)) {
          e.preventDefault()
        }
      }
    }

    // Дополнительно гасим secondary click на некоторых устройствах/браузерах
    const onMouseDown = (e) => {
      // 2 — secondary (ПКМ). Для надёжности проверим и which
      if ((e.button === 2 || e.which === 3) && !isAllowedTarget(e.target)) {
        e.preventDefault()
      }
    }

    // Вешаем на фазе перехвата, чтобы опередить другие обработчики
    document.addEventListener('contextmenu', onContextMenu, { capture: true })
    document.addEventListener('keydown', onKeyDown, { capture: true })
    document.addEventListener('mousedown', onMouseDown, { capture: true })
  }

  // Пример: запрещаем везде, но разрешаем в текстовых полях и на элементах с классом .allow-context
  blockContextMenu({
    allowSelectors: [
      'input',
      'textarea',
      '[contenteditable="true"]',
      '.allow-context'
    ]
  })
})()
